# ── Soundwave AI server configuration ─────────────────────────────
# Copy to .env and fill in. ALL secrets are required in production.
# The server refuses to boot in production if any required value is missing.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string (Prisma). Optional!
# Leave commented out to use the built-in zero-setup local store (server/data/store.json).
# DATABASE_URL=postgresql://user:password@localhost:5432/soundwave

# Auth
JWT_ACCESS_SECRET=change-me-32-random-bytes
JWT_REFRESH_SECRET=change-me-32-random-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Comma-separated allowed CORS origins in production (no wildcard).
CORS_ORIGINS=https://app.soundwave.ai

# OAuth (Google). Leave blank to disable — the sign-in/up pages then hide
# the Google button via GET /api/v1/auth/providers. The redirect URI must be:
#   http://localhost:5173/api/v1/auth/oauth/google/callback
# (replace the origin with APP_URL in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Soundwave AI <no-reply@soundwave.ai>"
APP_URL=http://localhost:5173

# Storage (S3-compatible: AWS S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Optional local FFmpeg binary path (vendored binary is auto-detected otherwise)
FFMPEG_PATH=

# YouTube import (video compositor "Import from YouTube"). The vendored
# zipapp at ../vendor/yt-dlp/yt-dlp is auto-detected (requires python3);
# set YTDLP_PATH to use a system yt-dlp instead. YTDLP_COOKIES optionally
# points at a Netscape cookies.txt export to pass YouTube bot/age checks.
YTDLP_PATH=
YTDLP_COOKIES=
# Reject YouTube videos longer than this (seconds; 1200 = 20 min, 0 = no limit)
YTDLP_MAX_DURATION=1200
# Hard timeout for a single YouTube download (milliseconds)
YTDLP_TIMEOUT_MS=240000

# ── Local voice service (voiceclone/) ────────────────────────────
# One service, two engines: cloned voices (Chatterbox, MIT for code AND weights)
# and narration voices that run on this machine (Kokoro-82M, Apache-2.0 code and
# weights). See voiceclone/README.md.
# LOCAL_VOICE_URL is the name that says what the service now is; VOICECLONE_URL
# is still read, so existing installs keep working.
# Leave both empty and neither local feature is offered.
LOCAL_VOICE_URL=
VOICECLONE_URL=
# Shared secret between this API and the sidecar. REQUIRED whenever
# VOICECLONE_URL is not localhost (HF Space, tunnel, remote host) — the
# sidecar enforces the same VOICECLONE_TOKEN.
VOICECLONE_TOKEN=
# Minimum plan allowed to use cloned voices: FREE, PRO, or ENTERPRISE.
VOICECLONE_MIN_PLAN=FREE

# Plan assigned to NEW accounts (FREE default). Set ENTERPRISE locally to
# test 4K export, full quotas, and cloud projects — the server screams in
# the log if this is ever non-FREE in production. REMOVE before publishing.
DEFAULT_SIGNUP_PLAN=FREE
# CPU generation is slow — keep the timeout generous.
VOICECLONE_TIMEOUT_MS=600000
