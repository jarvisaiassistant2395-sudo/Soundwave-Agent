# ── Soundwave AI server configuration ─────────────────────────────
# Copy to .env and fill in. ALL secrets are required in production.
# The server refuses to boot in production if any required value is missing.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string (Prisma). Optional!
# Leave commented out to use the built-in zero-setup local store (server/data/store.json).
# DATABASE_URL=postgresql://user:password@localhost:5432/soundwave

# Auth
JWT_ACCESS_SECRET=change-me-32-random-bytes
JWT_REFRESH_SECRET=change-me-32-random-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Comma-separated allowed CORS origins in production (no wildcard).
CORS_ORIGINS=https://app.soundwave.ai

# What may be trusted when working out a client's IP address — the key every
# rate limit and the sign-in throttle is counted against. Leave it EMPTY unless
# something really is in front of this server:
#   (empty)      trust nothing; use the connection's own address (safest)
#   1            one reverse proxy in front (docker-compose's Caddy/nginx)
#   loopback     a proxy on this same machine
# Any larger number (or `true`) lets a caller forge their own address in
# X-Forwarded-For and hand themselves a fresh rate-limit bucket per request.
# TRUST_PROXY=1

# A server with DATABASE_URL set refuses to start if Postgres is unreachable,
# rather than coming up on an empty local JSON store where every existing
# account looks deleted. Set this to 1 to accept the fallback on purpose.
# ALLOW_JSON_FALLBACK=0

# The log file (lib/log.ts). The desktop app points this at its own data dir;
# a hosted server normally leaves it alone and logs to stdout for the platform
# to collect. SOUNDWAVE_LOG_FILE names one file, SOUNDWAVE_LOG_DIR keeps one
# dated file per day (7 kept).
# SOUNDWAVE_LOG_DIR=/var/log/soundwave

# Google (the one way into the app). Signing in runs the installed-app
# loopback flow, so this must be an OAuth client of type "Desktop app" and no
# redirect URI has to be registered (any http://127.0.0.1:<port> is allowed).
# The same client is used for YouTube. Leave blank and the first launch explains
# that a client is needed — a dev build can still open via /api/v1/auth/dev-session.
SOUNDWAVE_YOUTUBE_CLIENT_ID=
SOUNDWAVE_YOUTUBE_CLIENT_SECRET=

# Stripe - the plans people pay for (Settings -> Billing).
# Make four recurring prices in the Stripe dashboard (Products; one per plan and
# interval) and paste their ids here. A plan with no price is not offered.
# Upgrading opens Stripe Checkout in the person's own browser, and the plan then
# follows from the subscription: the signed webhook when Stripe can reach this
# server, and asking Stripe directly when someone comes back to Billing (which is
# how it works in the desktop app, where a PC at home has no public address).
# The build you are running: empty/"retail" sells plans, "personal" is the
# owner's own build - no billing routes at all, everything unlocked. The desktop
# shell sets it for the packaged editions; on a self-hosted server you normally
# leave it alone.
# SOUNDWAVE_EDITION=retail
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=
# The Founder lifetime: a ONE-TIME price (Checkout runs in payment mode).
# Leave it empty and the offer simply isn't shown. FOUNDER_SEATS caps it.
STRIPE_PRICE_LIFETIME=
FOUNDER_SEATS=100
# The day the plans were repackaged (Pro $12 → $15, minutes instead of
# characters). Subscriptions that started before it keep their old price.
# PRICING_CHANGED_AT=2026-10-06
# Where Stripe lives - only tests (and a mirror) change this.
# STRIPE_API_BASE=https://api.stripe.com

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Soundwave AI <no-reply@soundwave.ai>"
APP_URL=http://localhost:5173

# Storage (S3-compatible: AWS S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Optional local FFmpeg binary path (vendored binary is auto-detected otherwise)
FFMPEG_PATH=

# YouTube import (video compositor "Import from YouTube"). The vendored
# zipapp at ../vendor/yt-dlp/yt-dlp is auto-detected (requires python3);
# set YTDLP_PATH to use a system yt-dlp instead. YTDLP_COOKIES optionally
# points at a Netscape cookies.txt export to pass YouTube bot/age checks.
YTDLP_PATH=
YTDLP_COOKIES=
# Reject YouTube videos longer than this (seconds; 1200 = 20 min, 0 = no limit)
YTDLP_MAX_DURATION=1200
# Hard timeout for a single YouTube download (milliseconds)
YTDLP_TIMEOUT_MS=240000

# ── The viral edit: popup photos and sound effects ───────────────
# Shorts get their popup photos from Wikimedia Commons (free, no key, free
# licences only — every photographer is credited in the video's description).
# Point COMMONS_API_URL at a mirror of your own to route that traffic
# elsewhere; the free sound effects are synthesized on this PC with FFmpeg and
# cached under DATA_DIR/sfx, so there is nothing to configure for them.
COMMONS_API_URL=https://commons.wikimedia.org/w/api.php

# ── Local voice service (voiceclone/) ────────────────────────────
# One service, two engines: cloned voices (Chatterbox, MIT for code AND weights)
# and narration voices that run on this machine (Kokoro-82M, Apache-2.0 code and
# weights). See voiceclone/README.md.
# LOCAL_VOICE_URL is the name that says what the service now is; VOICECLONE_URL
# is still read, so existing installs keep working.
# Leave both empty and neither local feature is offered.
LOCAL_VOICE_URL=
VOICECLONE_URL=
# Shared secret between this API and the sidecar. REQUIRED whenever
# VOICECLONE_URL is not localhost (HF Space, tunnel, remote host) — the
# sidecar enforces the same VOICECLONE_TOKEN.
VOICECLONE_TOKEN=
# Minimum plan allowed to use cloned voices: FREE, PRO, or ENTERPRISE.
VOICECLONE_MIN_PLAN=FREE

# Plan assigned to NEW accounts (FREE default). Set ENTERPRISE locally to
# test 4K export, full quotas, and cloud projects — the server screams in
# the log if this is ever non-FREE in production. REMOVE before publishing.
DEFAULT_SIGNUP_PLAN=FREE
# CPU generation is slow — keep the timeout generous.
VOICECLONE_TIMEOUT_MS=600000
