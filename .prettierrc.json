{
  "printWidth": 140,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    { "files": "*.md", "options": { "printWidth": 100, "proseWrap": "preserve" } },
    { "files": "*.yml", "options": { "printWidth": 120 } }
  ]
}
