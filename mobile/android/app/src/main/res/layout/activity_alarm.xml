<?xml version="1.0" encoding="utf-8"?>
<!-- The alarm screen: big time, the label, Snooze / Turn off, then the countdown. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/sw_navy"
    android:padding="28dp">

    <TextView
        android:id="@+id/alarm_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="64sp"
        android:textStyle="bold"
        android:text="7:00 AM" />

    <TextView
        android:id="@+id/alarm_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#C7CBD6"
        android:textSize="18sp"
        android:text="Soundwave alarm" />

    <LinearLayout
        android:id="@+id/alarm_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="44dp">

        <Button
            android:id="@+id/alarm_dismiss"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Turn off"
            android:textSize="18sp" />

        <Button
            android:id="@+id/alarm_snooze"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="Snooze 9 min"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/alarm_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:textColor="#C7CBD6"
        android:textSize="18sp"
        android:visibility="gone"
        android:text="Your briefing starts in 30 seconds" />
</LinearLayout>
