# ── Soundwave AI sales site — environment ─────────────────────────────────
# Copy to .env and fill in, or export these before `node server.mjs`.
# Nothing here is required to *view* the site; they are only needed to sell.

# ── Server ────────────────────────────────────────────────────────────────
PORT=4173
HOST=0.0.0.0
# The public address Stripe sends buyers back to. Must match what you gave Stripe.
# Leave empty to use the origin of the incoming request (fine for local testing).
SITE_URL=https://soundwave.ai

# ── Stripe ────────────────────────────────────────────────────────────────
# Secret key: sk_test_… while you test, sk_live_… when you're ready.
# NEVER commit this. It only ever lives on the server.
STRIPE_SECRET_KEY=

# Price IDs from your Stripe dashboard (Product → Pricing → the price's API ID).
# Create one price per plan per interval: 6 prices for the plans in config.js.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=

# "subscription" (default) for recurring plans, "payment" if you sell a
# one-time licence instead. Set the same mode on every price you create.
STRIPE_MODE=subscription

# Only set this to test against a Stripe stand-in; leave empty in production.
# STRIPE_API_BASE=

# ── Static hosting only ───────────────────────────────────────────────────
# If you would rather not run this server at all, leave it out and paste your
# Stripe Payment Links into PAYMENTS.links in config.js. They work anywhere.
